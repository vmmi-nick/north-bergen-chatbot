# Copy these names into Render: Service > Environment. Do NOT put real values in this file.

# Meta Model API key (from the Model API dashboard at dev.meta.ai, API keys).
# Optional for the test: without it, questions the local index does not cover
# return the Township Help Desk fallback. The $10 test spending cap is set on
# the Meta account itself, not here.
MODEL_API_KEY=

# Optional. Defaults to muse-wonder-1.0.
MODEL_ID=muse-wonder-1.0

# Render sets PORT automatically. Locally the server defaults to 3000.
PORT=3000

# Optional. Enables the token-protected GET /api/admin/unanswered endpoint
# that lists unmatched questions for index review (see README, Question
# logging). Any long random string. Send it as header x-admin-token.
# Leave unset to keep the endpoint disabled.
ADMIN_TOKEN=
